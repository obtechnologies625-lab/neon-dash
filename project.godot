; Engine configuration file.
; Generated for the Neon Dash endless runner.

config_version=5

[application]

config/name="Neon Dash"
config/description="An endless runner built with Godot 4 and GDScript."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Controls="*res://scripts/controls.gd"
HighScore="*res://scripts/high_score.gd"
GameSettings="*res://scripts/settings.gd"
SoundFx="*res://scripts/audio.gd"
GFX="*res://scripts/gfx.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"